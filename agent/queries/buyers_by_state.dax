// Buyers per state of interest, resolved to 2-letter postal codes via the
// state key table. "Nationwide" and regional buckets come back with blank
// postal — the script folds "Nationwide" into its own count.
// Dataset: "USA preferences Main_".
EVALUATE
SUMMARIZECOLUMNS (
    'Ключ к картам'[postal],
    'Ключ к картам'[name],
    FILTER ( 'Инфа для карт', 'Инфа для карт'[Тип компании] = "Buyer" ),
    "Count", DISTINCTCOUNT ( 'Инфа для карт'[Id компании] )
)
ORDER BY [Count] DESC
