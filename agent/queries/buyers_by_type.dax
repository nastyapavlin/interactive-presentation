// Platform network by institution type ("Тип типов компании"), whole network
// (no Buyer filter — the CRM's Buyer flag is sparsely filled, while institution
// types are set network-wide). Dataset: "USA preferences Main_".
EVALUATE
SUMMARIZECOLUMNS (
    'Инфа для карт'[Тип типов компании],
    "Count", DISTINCTCOUNT ( 'Инфа для карт'[Id компании] )
)
ORDER BY [Count] DESC
